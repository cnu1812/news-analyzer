# Environment Variables for Morning Pulse
# Copy this file to .env for local development (never commit .env!)

# ── Required ──────────────────────────────────────────────────────────────────

# Groq API key (free at https://console.groq.com)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ElevenLabs API key (free at https://elevenlabs.io)
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google AI API key (free at https://aistudio.google.com)
GOOGLE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Set to 'true' to use Gemini as the primary model instead of Groq
PREFER_GEMINI=false

# Optional: Choose the Gemini model (default: gemini-2.0-flash)
# For best results, you can use 'gemini-2.0-pro-exp' (if invited/available)
GEMINI_MODEL=gemini-2.0-flash

# Tavily Search API key (free at https://tavily.com)
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Discord Webhook URL
# How to get: Server → Channel Settings → Integrations → Webhooks → Create Webhook → Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/xxxx
